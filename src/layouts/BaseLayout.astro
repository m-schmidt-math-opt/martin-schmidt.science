---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import { aboutProfile } from '../data/about';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	robots?: string;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const defaultTitle = `${aboutProfile.name} — Nonlinear Optimization at ${aboutProfile.institution}`;
const {
	title = defaultTitle,
	description = `Academic website of ${aboutProfile.name}, ${aboutProfile.position} at ${aboutProfile.institution}.`,
	canonicalPath = Astro.url.pathname,
	image = aboutProfile.portrait.src,
	robots,
	structuredData,
} = Astro.props;

const pageTitle = title === defaultTitle ? title : `${title} | ${aboutProfile.name}`;
const canonicalUrl = Astro.site && new URL(canonicalPath, Astro.site);
const imageUrl = Astro.site && new URL(image, Astro.site);
const jsonLd = structuredData && JSON.stringify(structuredData).replaceAll('<', '\\u003c');

const navigation = [
	{ label: 'Research', href: '/research/' },
	{ label: 'Publications', href: '/publications/' },
	{ label: 'Talks', href: '/talks/' },
	{ label: 'Group', href: '/group/' },
	{ label: 'Software & Data', href: '/software-data/' },
	{ label: 'Teaching', href: '/teaching/' },
	{ label: 'About', href: '/about/' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f6f2e9" />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl.href} />}
		<meta property="og:site_name" content={aboutProfile.name} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl.href} />}
		{imageUrl && <meta property="og:image" content={imageUrl.href} />}
		{imageUrl && <meta property="og:image:alt" content={`Portrait of ${aboutProfile.name}`} />}
		{imageUrl && <meta property="og:image:width" content="960" />}
		{imageUrl && <meta property="og:image:height" content="640" />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{imageUrl && <meta name="twitter:image" content={imageUrl.href} />}
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
	</head>
	<body id="top">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-name" href="/" aria-label={`${aboutProfile.name} — Home`}>
					<span>{aboutProfile.name}</span>
					<small>{aboutProfile.siteSubtitle}</small>
				</a>

				<nav class="site-nav" aria-label="Primary navigation">
					<ul>
						{navigation.map((item) => (
							<li><a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a></li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<SiteFooter />
		<a class="back-to-top" href="#top" aria-label="Back to top"><span aria-hidden="true">↑</span></a>
	</body>
</html>
