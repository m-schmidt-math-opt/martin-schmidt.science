---
import { projects } from '../data/projects';
import { resources } from '../data/resources';
import { publicationsByKeys } from '../lib/publications';

interface Props {
	variant?: 'homepage' | 'research';
}

const { variant = 'homepage' } = Astro.props;
const bobilib = resources.find((resource) => resource.id === 'bobilib')!;
const a3g = projects.find((project) => project.id === 'a3g')!;
const symbi = projects.find((project) => project.id === 'symbi')!;
const [bilevelBook, uncertaintySurvey, implicitNonlinearities] = publicationsByKeys([
	'Beck_Ljubic_Schmidt:2026',
	'Beck_et_al:2023a',
	'Schmidt_et_al:2022',
]);
const homepageItems = [
	{ type: 'Benchmark Library', title: bobilib.name, description: bobilib.description, href: bobilib.links[0].href, linkLabel: bobilib.links[0].label },
	{ type: 'Book', title: bilevelBook.title, description: bilevelBook.authors, href: `/publications/#publication-${bilevelBook.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`, linkLabel: 'View publication' },
	{ type: 'Current Project', title: a3g.title, description: a3g.description, href: `/projects/#${a3g.id}`, linkLabel: 'View A3G project' },
	{ type: 'Current Project', title: symbi.title, description: symbi.description, href: `/projects/#${symbi.id}`, linkLabel: 'View SymBi project' },
];
const researchPageItems = [
	homepageItems[0],
	homepageItems[1],
	{ type: 'Journal Article', title: uncertaintySurvey.title, description: uncertaintySurvey.authors, href: `/publications/#publication-${uncertaintySurvey.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`, linkLabel: 'View publication' },
	{ type: 'Journal Article', title: implicitNonlinearities.title, description: implicitNonlinearities.authors, href: `/publications/#publication-${implicitNonlinearities.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`, linkLabel: 'View publication' },
];
const selectedItems = variant === 'research' ? researchPageItems : homepageItems;
const sectionDescription = variant === 'research'
	? 'A curated cross-section of publications and open research resources.'
	: 'Representative work across publications, research tools, and collaborative projects.';
---

<section class="selected-research" aria-labelledby="selected-research-title">
	<div class="selected-research__inner">
		<header class="selected-research__heading">
			<div>
				<p class="eyebrow">A research cross-section</p>
				<h2 id="selected-research-title">Selected Research</h2>
			</div>
			<p>{sectionDescription}</p>
		</header>

		<div class="selected-research__list">
			{selectedItems.map((item) => (
				<article class="research-output">
					<p class="research-output__type">{item.type}</p>
					<h3>{item.title}</h3>
					<p class="research-output__description">{item.description}</p>
					<a href={item.href}>{item.linkLabel}<span aria-hidden="true"> →</span></a>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.selected-research {
		border-top: 1px solid var(--color-rule);
	}

	.selected-research__inner {
		width: min(100%, var(--page-width));
		margin-inline: auto;
		padding: clamp(4rem, 9vw, 7rem) var(--page-gutter) clamp(5rem, 11vw, 9rem);
	}

	.selected-research__heading {
		display: grid;
		gap: 1.25rem;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.selected-research__heading h2 {
		font-size: clamp(2.35rem, 6vw, 4rem);
		letter-spacing: -0.025em;
	}

	.selected-research__heading > p {
		max-width: 32rem;
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.selected-research__list {
		border-bottom: 1px solid var(--color-rule);
	}

	.research-output {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		padding-block: 1.75rem;
		border-top: 1px solid var(--color-rule);
	}

	.research-output__type {
		margin-bottom: 0.8rem;
		color: var(--color-accent);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.research-output h3 {
		font-size: clamp(1.45rem, 5vw, 2rem);
	}

	.research-output__description {
		margin-top: 0.8rem;
		color: var(--color-muted);
		font-size: 0.93rem;
		line-height: 1.65;
	}

	.research-output a {
		margin-top: 1.35rem;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
	}

	@media (min-width: 45rem) {
		.selected-research__heading {
			align-items: end;
			grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.65fr);
			gap: 3rem;
		}

		.selected-research__list {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.research-output {
			min-height: 18rem;
			padding: 2rem clamp(1.5rem, 3vw, 3rem) 2.25rem 0;
		}

		.research-output:nth-child(even) {
			padding-right: 0;
			padding-left: clamp(1.5rem, 3vw, 3rem);
			border-left: 1px solid var(--color-rule);
		}

		.research-output a {
			margin-top: auto;
			padding-top: 1.5rem;
		}
	}
</style>
