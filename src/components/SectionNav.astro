---
interface SectionLink {
	id: string;
	label: string;
}

interface Props {
	sections: SectionLink[];
	label?: string;
	variant?: 'sections' | 'alphabet';
}

const { sections, label = 'On this page', variant = 'sections' } = Astro.props;
---

<nav class:list={['section-nav', { 'section-nav--alphabet': variant === 'alphabet' }]} aria-label={label}>
	{sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
</nav>
