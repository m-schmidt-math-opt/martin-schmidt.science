---
import PersonPortrait from './PersonPortrait.astro';
import ResourceList from './ResourceList.astro';
import { aboutProfile, academicLeadership, academicPositions, editorialService } from '../data/about';
import { focusLine, getCurrentPeople } from '../data/people';
import { featuredResources } from '../data/resources';
import { formatNewsDate, homepageNews } from '../data/news';
import { externalLinkAttributes } from '../lib/links';
import { publicationAnchor } from '../lib/publications';
const activityHref = (item: (typeof homepageNews)[number]) => item.publicationKey
	? `/publications/#${publicationAnchor(item.publicationKey)}`
	: item.link?.href;
const formatList = (items: string[]) => {
	if (items.length < 2) return items[0] ?? '';
	if (items.length === 2) return `${items[0]} and ${items[1]}`;
	return `${items.slice(0, -1).join(', ')}, and ${items.at(-1)}`;
};
const careerOrganizations = [...new Set(academicPositions.flatMap((position) => position.organization ? [position.organization] : []))];
const serviceDimensions = [editorialService.length && 'editorial work', academicLeadership.length && 'leadership roles'].filter((item): item is string => Boolean(item));
const profileTeaser = `My academic career has included positions at ${formatList(careerOrganizations)}. My academic service includes ${formatList(serviceDimensions)}.`;
const researchStaff = [...getCurrentPeople('postdoc'), ...getCurrentPeople('phd')];
const supportStaff = getCurrentPeople('secretary');
---

<section class="group-preview home-section" aria-labelledby="group-preview-title">
	<div class="home-section__inner group-preview__layout">
		<header class="home-section__heading">
			<h2 id="group-preview-title">Research Group</h2>
			<p>A team of postdoctoral and doctoral researchers in mathematical optimization, supported by the secretary’s office.</p>
			<a class="section-link" href="/group/">Meet the group<span aria-hidden="true"> →</span></a>
		</header>

		<div class="member-groups">
			<section class="member-group" aria-labelledby="research-staff-title">
				<h3 class="member-group__title" id="research-staff-title">Research staff</h3>
				<ul class="member-list">
					{researchStaff.map((person) => (
						<li class="member">
							<PersonPortrait person={person} class="member__portrait" />
							<div>
								<h4>{person.name}</h4>
								<p>{person.current?.role}</p>
								{focusLine(person) && <p class="member__focus">{focusLine(person)}</p>}
							</div>
						</li>
					))}
				</ul>
			</section>

			<section class="member-group member-group--support" aria-labelledby="support-staff-title">
				<h3 class="member-group__title" id="support-staff-title">Support</h3>
				<ul class="member-list member-list--support">
					{supportStaff.map((person) => (
						<li class="member member--support">
							<PersonPortrait person={person} class="member__portrait" />
							<div>
								<h4>{person.name}</h4>
								<p>{person.current?.role}</p>
							</div>
						</li>
					))}
				</ul>
			</section>
		</div>
	</div>
</section>

<section class="resources-preview home-section" aria-labelledby="resources-preview-title">
	<div class="home-section__inner">
		<header class="home-section__heading home-section__heading--row">
			<div>
				<h2 id="resources-preview-title">Software &amp; Data</h2>
				<p class="resources-preview__intro">A gateway to active benchmark libraries and research resources.</p>
			</div>
			<a class="section-link" href="/software-data/">Explore Software &amp; Data<span aria-hidden="true"> →</span></a>
		</header>

		<ResourceList resources={featuredResources} compact gateway />
	</div>
</section>

<section class="activity-preview home-section" aria-labelledby="activity-preview-title">
	<div class="home-section__inner activity-preview__layout">
		<header class="home-section__heading">
			<h2 id="activity-preview-title">Recent Activity</h2>
			<p>Recent talks, publications, projects, and other research activity.</p>
			<a class="section-link" href="/news/">All news<span aria-hidden="true"> →</span></a>
		</header>

		<ol class="activity-list">
			{homepageNews.map((item) => (
				<li>
					<p class="activity__meta"><time datetime={item.date}>{formatNewsDate(item.date, 'short')}</time><span>{item.category}</span></p>
					<p class="activity__title">{activityHref(item) ? <a href={activityHref(item)} {...externalLinkAttributes(activityHref(item)!)}>{item.title}</a> : item.title}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<section class="profile-preview home-section" aria-labelledby="profile-preview-title">
	<div class="home-section__inner profile-preview__layout">
		<div class="profile-preview__content">
			<h2 id="profile-preview-title">About Martin Schmidt</h2>
			<p>{profileTeaser}</p>
			<a class="section-link" href="/about/">View academic profile<span aria-hidden="true"> →</span></a>
		</div>

		<img class="profile-portrait" src={aboutProfile.portrait.src} alt={aboutProfile.portrait.alt} width="960" height="640" loading="lazy" />
	</div>
</section>

<style>
	.home-section__inner {
		width: min(100%, var(--page-width));
		margin-inline: auto;
		padding: var(--space-section-y) var(--page-gutter);
	}

	.home-section__heading {
		max-width: 38rem;
	}

	.home-section__heading h2,
	.profile-preview h2 {
		font-size: var(--featured-h2-size);
		letter-spacing: -0.025em;
	}

	.home-section__heading > p:last-of-type,
	.profile-preview__content > p {
		margin-top: 1.25rem;
		color: var(--color-muted);
	}

	.section-link {
		display: inline-block;
		margin-top: 1.5rem;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
	}

	.group-preview__layout,
	.activity-preview__layout,
	.profile-preview__layout {
		display: grid;
		gap: 3rem;
	}

	.member-list {
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--color-rule);
		list-style: none;
	}

	.member-group + .member-group {
		margin-top: 2.25rem;
	}

	.member-group__title {
		margin-bottom: 0.65rem;
		color: var(--color-accent);
		font-family: var(--font-body);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.member {
		display: grid;
		align-items: center;
		grid-template-columns: 7rem minmax(0, 1fr);
		gap: 1rem;
		padding-block: 1.2rem;
		border-top: 1px solid var(--color-rule);
	}

	.member :global(.member__portrait) {
		width: 7rem;
	}

	.member h4 {
		font-size: 1.2rem;
	}

	.member p {
		margin-top: 0.15rem;
		color: var(--color-muted);
		font-size: 0.78rem;
	}

	.member .member__focus {
		margin-top: 0.35rem;
		font-size: 0.875rem;
		line-height: 1.55;
		overflow-wrap: anywhere;
	}

	.member--support {
		grid-template-columns: 7rem minmax(0, 1fr);
		padding-block: 0.9rem;
	}

	.member--support :global(.member__portrait) {
		width: 7rem;
	}

	.home-section__heading--row {
		max-width: none;
		margin-bottom: var(--space-section-heading);
	}


	.activity-list {
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--color-rule);
		list-style: none;
	}

	.activity-list li {
		padding-block: 1.3rem;
		border-top: 1px solid var(--color-rule);
	}

	.activity__meta {
		display: flex;
		gap: 0.75rem;
		color: var(--color-accent);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.activity__meta span {
		padding-left: 0.75rem;
		border-left: 1px solid var(--color-rule);
	}

	.activity__title {
		margin-top: 0.35rem;
		font-family: var(--font-heading);
		font-size: clamp(1.12rem, 4vw, 1.4rem);
		line-height: 1.3;
	}

	.activity__title a { color: var(--color-text); text-decoration: none; }
	.activity__title a:hover { color: var(--color-accent); }

	.profile-preview__layout {
		align-items: center;
	}

	.profile-portrait { width:min(55vw,12rem);height:auto; }

	.profile-preview__content {
		max-width: 40rem;
	}

	@media (min-width: 45rem) {
		.group-preview__layout,
		.activity-preview__layout {
			grid-template-columns: minmax(17rem, 0.75fr) minmax(24rem, 1.25fr);
			gap: clamp(3rem, 8vw, 8rem);
		}

		.home-section__heading--row {
			display: flex;
			align-items: end;
			justify-content: space-between;
			gap: 2rem;
		}

		.home-section__heading--row .section-link {
			margin-bottom: 0.45rem;
		}

		.profile-preview__layout {
			grid-template-columns: minmax(0, 1fr) minmax(7rem, 9rem);
			gap: clamp(2.5rem, 7vw, 6rem);
		}

		.profile-portrait {
			width: 100%;
		}
	}
</style>
