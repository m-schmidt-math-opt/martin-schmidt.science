---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonPortrait from '../components/PersonPortrait.astro';
import SectionNav from '../components/SectionNav.astro';
import { focusLine, getAlumni, getCurrentPeople, type CurrentGroup } from '../data/people';
import { externalLinkAttributes } from '../lib/links';

const currentSections: Array<{ group: CurrentGroup; title: string }> = [
	{ group: 'secretary', title: "Secretary's Office" },
	{ group: 'postdoc', title: 'Postdocs' },
	{ group: 'phd', title: 'PhD Students' },
];

const formerPhds = getAlumni('former-phd');
const formerPostdocs = getAlumni('former-postdoc');
const sectionLinks = [
	...currentSections.map((section) => ({ id: section.group, label: section.title })),
	{ id: 'alumni', label: 'Alumni' },
	{ id: 'open-positions', label: 'Open Positions' },
];
---

<BaseLayout
	title="Research Group"
	description="Current members and alumni of Martin Schmidt’s nonlinear optimization research group at Trier University."
>
	<header class="group-intro page-shell" aria-labelledby="page-title">
		<h1 id="page-title">Research Group</h1>
		<p class="intro__lead">The team works on mathematical optimization, with an emphasis on hierarchical decisions, uncertainty, discrete structures, and nonlinear models.</p>
		<SectionNav sections={sectionLinks} label="Research group sections" />
	</header>

	<div class="group-sections">
		{currentSections.map((section) => (
			<section id={section.group} class="people-section" aria-labelledby={`${section.group}-title`}>
				<header class="people-section__heading">
					<h2 id={`${section.group}-title`}>{section.title}</h2>
				</header>
				<ul class="people-grid">
					{getCurrentPeople(section.group).map((person) => (
						<li>
							<article class="person-card">
								<PersonPortrait person={person} />
								<div class="person-card__content">
									<h3>{person.name}</h3>
									<p class="person-card__role">{person.current?.role}</p>
									{person.current?.startDate && <p class="person-card__meta">Since {person.current.startDate}</p>}
									{person.current?.affiliation && <p class="person-card__meta">{person.current.affiliation}</p>}
									{focusLine(person) && <p class="person-card__focus">{focusLine(person)}</p>}
									{person.current?.biography && <p class="person-card__bio">{person.current.biography}</p>}
									{(person.email || person.homepage) && (
										<ul class="person-card__links" aria-label={`Contact links for ${person.name}`}>
											{person.email && <li><a href={`mailto:${person.email}`}>Email</a></li>}
											{person.homepage && <li><a href={person.homepage} {...externalLinkAttributes(person.homepage)}>Homepage</a></li>}
										</ul>
									)}
								</div>
							</article>
						</li>
					))}
				</ul>
			</section>
		))}

		<section id="alumni" class="people-section alumni-section" aria-labelledby="alumni-title">
			<header class="people-section__heading">
				<h2 id="alumni-title">Alumni</h2>
			</header>
			<div class="alumni-columns">
				<section aria-labelledby="former-phd-title">
					<h3 id="former-phd-title">Former PhD Students</h3>
					<ul class="alumni-list">
						{formerPhds.map((person) => (
							<li>
								<strong>{person.name}</strong>
								{person.alumniRecord.dissertation && (
									<>
										<cite>{person.alumniRecord.dissertation.title}</cite>
										{person.alumniRecord.dissertation.institution && <small>{person.alumniRecord.dissertation.institution}</small>}
										{person.alumniRecord.dissertation.coSupervisor && <small>Co-supervision with {person.alumniRecord.dissertation.coSupervisor}</small>}
										{person.alumniRecord.dissertation.awards?.map((award) => <small class="alumni-award">{award}</small>)}
									</>
								)}
								{person.alumniRecord.currentPosition && <small>{person.alumniRecord.currentPosition}</small>}
							</li>
						))}
					</ul>
				</section>
				<section aria-labelledby="former-postdoc-title">
					<h3 id="former-postdoc-title">Former Postdocs</h3>
					<ul class="alumni-list">
						{formerPostdocs.map((person) => (
							<li><span>{person.name}</span>{person.alumniRecord.currentPosition && <small>{person.alumniRecord.currentPosition}</small>}{person.homepage && <a href={person.homepage} {...externalLinkAttributes(person.homepage)}>Homepage</a>}</li>
						))}
					</ul>
				</section>
			</div>
		</section>

		<section id="open-positions" class="people-section positions-section" aria-labelledby="positions-title">
			<header class="people-section__heading">
				<h2 id="positions-title">Open Positions</h2>
			</header>
			<p>There are currently no advertised positions.</p>
		</section>
	</div>
</BaseLayout>

<style>
	.group-intro { padding-bottom: var(--space-intro-to-first); }
	.group-intro h1 { font-size: var(--internal-h1-size); letter-spacing: -0.035em; }
	.people-section { width: min(100%, var(--page-width)); margin-inline: auto; padding: var(--space-section-y) var(--page-gutter); }
	.group-sections > .people-section:first-child { padding-top: var(--space-intro-to-first); }
	.people-section__heading { margin-bottom: var(--space-section-heading); }
	.people-section h2 { font-size: var(--section-h2-size); letter-spacing: -.025em; }
	.people-grid { display: grid; gap: 2.25rem 1.5rem; }
	.person-card { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1.25rem; min-width: 0; }
	.person-card :global(.person-portrait) { width: 8rem; }
	.person-card__content { min-width: 0; padding-top: .15rem; }
	.person-card h3 { font-size: clamp(1.35rem, 5vw, 1.7rem); overflow-wrap: anywhere; }
	.person-card__role { margin-top: .25rem; color: var(--color-accent); font-size: .72rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
	.person-card__focus { margin-top: .75rem; color: var(--color-muted); font-size: .84rem; line-height: 1.6; overflow-wrap: anywhere; }
	.person-card__meta { margin-top: .45rem; color: var(--color-muted); font-size: .76rem; line-height: 1.5; }
	.person-card__bio { margin-top: .65rem; color: var(--color-muted); font-size: .8rem; line-height: 1.6; overflow-wrap: anywhere; }
	.person-card__links { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin-top: .75rem; }
	.person-card__links a { font-size: .76rem; font-weight: 600; text-decoration: none; }
	.alumni-columns { display: grid; gap: 3rem; }
	.alumni-columns h3 { margin-bottom: 1rem; font-size: clamp(1.3rem, 4vw, 1.6rem); }
	.alumni-list { border-bottom: 1px solid var(--color-rule); }
	.alumni-list li { display: grid; gap: .15rem; padding-block: .75rem; border-top: 1px solid var(--color-rule); font-size: .9rem; }
	.alumni-list small { color: var(--color-muted); font-size: .75rem; line-height: 1.5; overflow-wrap: anywhere; }
	.alumni-list cite { color: var(--color-text); font-family: var(--font-heading); font-size: .86rem; line-height: 1.45; overflow-wrap: anywhere; }
	.alumni-list .alumni-award { color: var(--color-accent); }
	.positions-section > p { max-width: 35rem; color: var(--color-muted); }
	@media (min-width: 36rem) {
		.people-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.person-card { grid-template-columns: 10rem minmax(0, 1fr); }
		.person-card :global(.person-portrait) { width: 10rem; }
	}
	@media (min-width: 45rem) {
		.alumni-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(3rem, 8vw, 7rem); }
	}
</style>
