---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reviewingSummary, reviewingVenues } from '../data/reviewing';
---

<BaseLayout title="Reviewing Activity" description="Reviewing activity of Martin Schmidt across mathematical optimization, operations research, applied mathematics, and energy systems.">
	<header class="reviewing-intro page-shell" aria-labelledby="page-title">
		<h1 id="page-title">Reviewing Activity</h1>
		<p class="intro__lead">{reviewingSummary}</p>
	</header>
	<section class="reviewing-section" aria-labelledby="venues-title">
		<header class="reviewing-section__heading"><h2 id="venues-title">Reviewing Venues</h2></header>
		<p class="reviewing-source-note">The following is the complete reviewing list recorded on my previous academic website.</p>
		<ul class="reviewing-list">
			{reviewingVenues.map((venue) => <li id={venue.id}>{venue.name}</li>)}
		</ul>
	</section>
</BaseLayout>

<style>
	.reviewing-intro { padding-bottom: var(--space-intro-to-first); }
	.reviewing-intro h1 { font-size: var(--internal-h1-size); letter-spacing: -.035em; }
	.reviewing-section { width: min(100%, var(--page-width)); margin-inline: auto; padding: var(--space-intro-to-first) var(--page-gutter) var(--space-section-y); }
	.reviewing-section__heading { margin-bottom: var(--space-section-heading); }
	.reviewing-section h2 { font-size: var(--section-h2-size); letter-spacing: -.025em; }
	.reviewing-source-note { max-width: 44rem; margin-bottom: 1rem; color: var(--color-muted); font-size: .86rem; }
	.reviewing-list { columns: 1; border-bottom: 1px solid var(--color-rule); }
	.reviewing-list li { break-inside: avoid; padding: .7rem 0; border-top: 1px solid var(--color-rule); font-size: .88rem; overflow-wrap: anywhere; }
	@media (min-width: 45rem) { .reviewing-list { columns: 2; column-gap: clamp(2rem, 6vw, 5rem); } }
</style>
