---
import BaseLayout from '../layouts/BaseLayout.astro';
import TalkList from '../components/TalkList.astro';
import { invitedTalks, plenaryAndKeynoteTalks, talks } from '../data/talks';
const archive = [...talks].sort((a, b) => b.date.start.localeCompare(a.date.start) || (a.source?.recordNumber ?? Number.MAX_SAFE_INTEGER) - (b.source?.recordNumber ?? Number.MAX_SAFE_INTEGER));
const sections = [
	{ id: 'plenary-keynote', title: 'Plenary & Keynote Talks', items: plenaryAndKeynoteTalks },
	{ id: 'invited', title: 'Invited Talks', items: invitedTalks },
	{ id: 'archive', title: 'Full Archive', items: archive },
];
---
<BaseLayout title="Talks" description="Plenary, keynote, invited, and other talks by Martin Schmidt on mathematical optimization.">
	<header class="talks-intro page-shell" aria-labelledby="page-title"><h1 id="page-title">Talks</h1><p class="intro__lead">Selected invited presentations and a chronological archive of lectures, seminars, and conference talks.</p></header>
	<div class="archive-sections">{sections.map((section) => <section class="archive-section" aria-labelledby={`${section.id}-title`}><header class="archive-heading"><h2 id={`${section.id}-title`}>{section.title}</h2></header><TalkList talks={section.items} /></section>)}</div>
</BaseLayout>
<style>
	.talks-intro { padding-bottom: var(--space-section-y); }
	.talks-intro h1 { font-size: clamp(2.75rem, 9vw, 5.5rem); letter-spacing: -.035em; }
	.archive-section { width: min(100%, var(--page-width)); margin-inline: auto; padding: var(--space-section-y) var(--page-gutter); }
	.archive-heading { margin-bottom: var(--space-section-heading); }
	.archive-heading h2 { font-size: clamp(2rem, 6vw, 3.5rem); letter-spacing: -.025em; overflow-wrap: anywhere; }
</style>
