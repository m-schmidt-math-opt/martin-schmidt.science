---
import BaseLayout from '../layouts/BaseLayout.astro';
import { completedProjects, currentProjects, type Project } from '../data/projects';
const sections = [{ id: 'current', title: 'Current Projects', items: currentProjects }, { id: 'completed', title: 'Completed Projects', items: completedProjects }];
const dates = (project: Project) => [project.startDate, project.endDate].filter(Boolean).join('–');
---
<BaseLayout title="Research Projects" description="Current and completed research projects in nonlinear and mathematical optimization.">
	<header class="projects-intro page-shell" aria-labelledby="page-title"><h1 id="page-title">Research Projects</h1><p class="intro__lead">Scientific projects in mathematical optimization and its applications.</p></header>
	<div class="project-sections">{sections.map((section) => <section class="project-section" aria-labelledby={`${section.id}-projects-title`}><header class="project-heading"><h2 id={`${section.id}-projects-title`}>{section.title}</h2></header><ol class="project-list">{section.items.map((project) => <li><article id={project.id}><div><h3>{project.title}</h3></div><div class="project-content"><p class="project-description">{project.description}</p><dl>{project.fundingAgency && <div><dt>Funding</dt><dd>{project.fundingAgency}</dd></div>}{dates(project) && <div><dt>Period</dt><dd>{dates(project)}</dd></div>}{project.programme && <div><dt>Programme</dt><dd>{project.programme}</dd></div>}{project.role && <div><dt>Role</dt><dd>{project.role}</dd></div>}{project.partners?.length && <div><dt>Partners</dt><dd>{project.partners.join(' · ')}</dd></div>}</dl>{project.externalUrl && <a href={project.externalUrl}>Project website</a>}</div></article></li>)}</ol></section>)}</div>
</BaseLayout>
<style>
	.projects-intro { padding-bottom: var(--space-section-y); } .projects-intro h1 { font-size: var(--internal-h1-size); letter-spacing: -.035em; }
	.project-section { width: min(100%, var(--page-width)); margin-inline: auto; padding: var(--space-section-y) var(--page-gutter); }
	.project-heading { margin-bottom: var(--space-section-heading); } .project-heading h2 { font-size:clamp(2rem,6vw,3.5rem);letter-spacing:-.025em;overflow-wrap:anywhere; }
	.project-list { border-bottom:1px solid var(--color-rule); } .project-list > li { border-top:1px solid var(--color-rule); } .project-list article { display:grid;gap:1rem;padding-block:1.5rem;scroll-margin-top:2rem; } .project-list h3 { font-size:1.5rem;overflow-wrap:anywhere; } .project-content{min-width:0}.project-description { color:var(--color-muted);font-size:.88rem; } .project-list dl { margin:.8rem 0 0; } .project-list dl div { display:grid;grid-template-columns:4.5rem minmax(0,1fr);gap:.6rem;font-size:.75rem; } .project-list dt { font-weight:600; } .project-list dd { margin:0;color:var(--color-muted);overflow-wrap:anywhere } .project-list a { display:inline-block;margin-top:.8rem;font-size:.75rem;font-weight:600; }
	@media(min-width:45rem){.project-list article{grid-template-columns:minmax(14rem,.7fr) minmax(18rem,1fr);gap:2rem}}
</style>
