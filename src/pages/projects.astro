---
import BaseLayout from '../layouts/BaseLayout.astro';
import { completedProjects, currentProjects, type Project } from '../data/projects';
const sections = [{ number: '01', id: 'current', title: 'Current Projects', items: currentProjects }, { number: '02', id: 'completed', title: 'Completed Projects', items: completedProjects }];
const dates = (project: Project) => [project.startDate, project.endDate].filter(Boolean).join('–');
---
<BaseLayout title="Research Projects" description="Current and completed research projects in nonlinear and mathematical optimization.">
	<header class="projects-intro page-shell" aria-labelledby="page-title"><p class="eyebrow">Collaborative research</p><h1 id="page-title">Research Projects</h1><p class="intro__lead">Scientific projects in mathematical optimization and its applications.</p></header>
	<div class="project-sections">{sections.map((section) => <section class="project-section" aria-labelledby={`${section.id}-projects-title`}><header class="project-heading"><p aria-hidden="true">{section.number}</p><h2 id={`${section.id}-projects-title`}>{section.title}</h2></header>{section.items.length ? <ol class="project-list">{section.items.map((project) => <li><article><div><h3>{project.title}</h3>{project.shortName && <p class="project-short-name">{project.shortName}</p>}</div><p class="project-description">{project.description}</p><dl>{project.fundingAgency && <div><dt>Funding</dt><dd>{project.fundingAgency}</dd></div>}{dates(project) && <div><dt>Period</dt><dd>{dates(project)}</dd></div>}</dl>{project.externalUrl && <a href={project.externalUrl}>Project website</a>}</article></li>)}</ol> : <p class="project-placeholder">Verified {section.id} project information will be added here.</p>}</section>)}</div>
</BaseLayout>
<style>
	.projects-intro { padding-bottom: clamp(3.5rem, 8vw, 6rem); } .projects-intro h1 { font-size: clamp(2.75rem, 9vw, 5.5rem); letter-spacing: -.035em; }
	.project-sections { border-top: 1px solid var(--color-rule); } .project-section { width: min(100%, var(--page-width)); margin-inline: auto; padding: clamp(3.5rem, 8vw, 6.5rem) var(--page-gutter); } .project-section + .project-section { border-top: 1px solid var(--color-rule); }
	.project-heading { display: grid; grid-template-columns: 2rem minmax(0,1fr); gap: .75rem; margin-bottom: clamp(2rem,5vw,3.5rem); } .project-heading > p { padding-top:.4rem;color:var(--color-accent);font-size:.7rem;font-weight:600; } .project-heading h2 { font-size:clamp(2rem,6vw,3.5rem);letter-spacing:-.025em;overflow-wrap:anywhere; }
	.project-placeholder { padding-block:1.25rem;border-block:1px solid var(--color-rule);color:var(--color-muted);font-size:.88rem;font-style:italic; }
	.project-list { border-bottom:1px solid var(--color-rule); } .project-list > li { border-top:1px solid var(--color-rule); } .project-list article { display:grid;gap:1rem;padding-block:1.5rem; } .project-list h3 { font-size:1.5rem;overflow-wrap:anywhere; } .project-short-name { color:var(--color-accent);font-size:.72rem;font-weight:600; } .project-description { color:var(--color-muted);font-size:.88rem; } .project-list dl { margin:0; } .project-list dl div { display:flex;gap:.6rem;font-size:.75rem; } .project-list dt { font-weight:600; } .project-list dd { margin:0;color:var(--color-muted); } .project-list a { font-size:.75rem;font-weight:600; }
	@media(min-width:45rem){.project-heading{grid-template-columns:3rem minmax(0,1fr)}.project-list article{grid-template-columns:minmax(14rem,.7fr) minmax(18rem,1fr);gap:2rem}.project-list dl,.project-list>a{grid-column:2}}
</style>
