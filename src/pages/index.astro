---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageSections from '../components/HomepageSections.astro';
import SelectedResearch from '../components/SelectedResearch.astro';
import { aboutProfile } from '../data/about';
import { researchThemes } from '../data/research';

const homepageTitle = `${aboutProfile.name} — Nonlinear Optimization at ${aboutProfile.institution}`;
const homepageDescription = `${aboutProfile.name} is ${aboutProfile.position} at ${aboutProfile.institution}, researching mathematical optimization with a focus on bilevel optimization.`;
const homepageCountry = aboutProfile.contact.addressLines.at(-1);
const homepageInstitution = [aboutProfile.institution, homepageCountry].filter(Boolean).join(', ');
const personStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: aboutProfile.name,
	url: 'https://martin-schmidt.science/',
	image: new URL(aboutProfile.portrait.src, 'https://martin-schmidt.science').href,
	jobTitle: aboutProfile.position,
	worksFor: {
		'@type': 'Organization',
		name: aboutProfile.institution,
	},
	knowsAbout: researchThemes.map((theme) => theme.title),
	sameAs: [aboutProfile.contact.institutionUrl, ...aboutProfile.profileLinks.map((link) => link.href)],
};
---

<BaseLayout
	title={homepageTitle}
	description={homepageDescription}
	structuredData={personStructuredData}
>
	<section class="hero page-shell" aria-labelledby="page-title">
		<div class="hero__content">
			<h1 id="page-title">{aboutProfile.name}</h1>
			<p class="hero__affiliation">{homepageInstitution}</p>
			<p class="hero__statement">
				My research focuses on bilevel, mixed-integer, nonlinear, robust, and network optimization and equilibrium problems with applications in energy systems and markets as well as machine learning and AI.
			</p>

			<nav class="hero__links" aria-label="Explore research">
				<a href="/research/">Research</a>
				<a href="/publications/">Publications</a>
				<a href="/group/">Group</a>
			</nav>
		</div>

		<figure class="hero-visual">
			<img
				src="/images/homepage-optimization-abstract.png"
				alt="Optimization diagram with feasible region and objective directions"
				width="550"
				height="425"
				fetchpriority="high"
				decoding="async"
			/>
		</figure>
	</section>

	<section class="research-themes" aria-labelledby="research-themes-title">
		<div class="research-themes__inner">
			<header class="section-heading">
				<h2 id="research-themes-title">Core Research Topics</h2>
			</header>

			<div class="theme-list">
				{researchThemes.map((theme) => (
					<article class="theme">
						<h3>{theme.title}</h3>
						<p>{theme.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<SelectedResearch />
	<HomepageSections />
</BaseLayout>
