---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageSections from '../components/HomepageSections.astro';
import SelectedResearch from '../components/SelectedResearch.astro';
import { researchThemes } from '../data/research';
---

<BaseLayout
	description="Martin Schmidt is Professor of Nonlinear Optimization at Trier University, working on bilevel, mixed-integer, robust, equilibrium, and network optimization."
>
	<section class="hero page-shell" aria-labelledby="page-title">
		<div class="hero__content">
			<p class="eyebrow">Professor of Nonlinear Optimization</p>
			<h1 id="page-title">Martin Schmidt</h1>
			<p class="hero__affiliation">Trier University</p>
			<p class="hero__statement">
				My research develops mathematical models and algorithms for structured optimization
				problems, with a particular interest in hierarchical decisions and complex systems.
			</p>

			<nav class="hero__links" aria-label="Explore research">
				<a href="/research/">Research</a>
				<a href="/publications/">Publications</a>
				<a href="/group/">Group</a>
			</nav>
		</div>

		<div class="hero-geometry" aria-hidden="true">
			<span class="hero-geometry__orbit"></span>
			<span class="hero-geometry__path"></span>
			<span class="hero-geometry__node hero-geometry__node--one"></span>
			<span class="hero-geometry__node hero-geometry__node--two"></span>
			<span class="hero-geometry__node hero-geometry__node--three"></span>
		</div>
	</section>

	<section class="research-themes" aria-labelledby="research-themes-title">
		<div class="research-themes__inner">
			<header class="section-heading">
				<p class="eyebrow">Areas of inquiry</p>
				<h2 id="research-themes-title">Core Research Themes</h2>
			</header>

			<div class="theme-list">
				{researchThemes.map((theme, index) => (
					<article class="theme">
						<p class="theme__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
						<h3>{theme.title}</h3>
						<p>{theme.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<SelectedResearch />
	<HomepageSections />
</BaseLayout>
