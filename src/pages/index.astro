---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageSections from '../components/HomepageSections.astro';
import SelectedResearch from '../components/SelectedResearch.astro';
import { aboutProfile } from '../data/about';
import { researchThemes } from '../data/research';

const homepageTitle = `${aboutProfile.name} — Nonlinear Optimization at ${aboutProfile.institution}`;
const homepageDescription = `${aboutProfile.name} is ${aboutProfile.position} at ${aboutProfile.institution}, researching mathematical optimization with a focus on bilevel optimization.`;
---

<BaseLayout
	title={homepageTitle}
	description={homepageDescription}
>
	<section class="hero page-shell" aria-labelledby="page-title">
		<div class="hero__content">
			<h1 id="page-title">{aboutProfile.name}</h1>
			<p class="hero__affiliation">{aboutProfile.institution}</p>
			<p class="hero__statement">
				My research develops mathematical models and algorithms for structured optimization
				problems, with a particular interest in hierarchical decisions and complex systems.
			</p>

			<nav class="hero__links" aria-label="Explore research">
				<a href="/research/">Research</a>
				<a href="/publications/">Publications</a>
				<a href="/group/">Group</a>
			</nav>
		</div>

		<figure class="hero-visual">
			<img
				src="/images/homepage-optimization.png"
				alt="Optimization diagram"
				width="804"
				height="512"
			/>
		</figure>
	</section>

	<section class="research-themes" aria-labelledby="research-themes-title">
		<div class="research-themes__inner">
			<header class="section-heading">
				<h2 id="research-themes-title">Core Research Themes</h2>
			</header>

			<div class="theme-list">
				{researchThemes.map((theme) => (
					<article class="theme">
						<h3>{theme.title}</h3>
						<p>{theme.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<SelectedResearch />
	<HomepageSections />
</BaseLayout>
