---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutProfile, academicPositions, awards, education, invitedTalks, professionalService } from '../data/about';

const contactAvailable = aboutProfile.contact.email || aboutProfile.contact.address || aboutProfile.contact.institutionUrl;
const careerItems = [...academicPositions, ...education];
---

<BaseLayout title="About Martin Schmidt" description="Academic biography, contact information, positions, honors, and professional service of Martin Schmidt, Professor of Nonlinear Optimization at Trier University.">
	<header class="about-intro page-shell" aria-labelledby="page-title">
		<p class="eyebrow">Academic profile</p>
		<h1 id="page-title">About Martin Schmidt</h1>
		<p class="intro__lead">{aboutProfile.position} at {aboutProfile.institution}.</p>
	</header>
	<div class="about-sections">
		<section class="about-section about-bio" aria-labelledby="bio-title">
			<header class="about-section__heading"><p aria-hidden="true">01</p><h2 id="bio-title">Short Academic Biography</h2></header>
			<p>{aboutProfile.biography}</p>
			{aboutProfile.profileLinks.length > 0 && <ul class="profile-links" aria-label="External profiles">{aboutProfile.profileLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
		</section>
		<section class="about-section" aria-labelledby="contact-title">
			<header class="about-section__heading"><p aria-hidden="true">02</p><h2 id="contact-title">Contact</h2></header>
			{contactAvailable ? <address>{aboutProfile.contact.address && <span>{aboutProfile.contact.address}</span>}{aboutProfile.contact.email && <a href={`mailto:${aboutProfile.contact.email}`}>{aboutProfile.contact.email}</a>}{aboutProfile.contact.institutionUrl && <a href={aboutProfile.contact.institutionUrl}>University profile</a>}</address> : <p class="pending-note">Contact details are pending verification.</p>}
		</section>
		<section class="about-section" aria-labelledby="career-title">
			<header class="about-section__heading"><p aria-hidden="true">03</p><h2 id="career-title">Academic Positions &amp; Education</h2></header>
			<ul class="fact-list">{careerItems.map((item) => <li>{item.period && <time>{item.period}</time>}<div><h3>{item.title}</h3>{item.organization && <p>{item.organization}</p>}{item.detail && <p>{item.detail}</p>}</div></li>)}</ul>
			{education.length === 0 && <p class="subsection-pending">Education details are pending verification.</p>}
		</section>
		<section class="about-section" aria-labelledby="awards-title">
			<header class="about-section__heading"><p aria-hidden="true">04</p><h2 id="awards-title">Awards &amp; Honors</h2></header>
			{awards.length ? <ul class="fact-list">{awards.map((item) => <li>{item.period && <time>{item.period}</time>}<div><h3>{item.title}</h3>{item.organization && <p>{item.organization}</p>}</div></li>)}</ul> : <p class="pending-note">Awards and honors are pending verification.</p>}
		</section>
		<section class="about-section" aria-labelledby="service-title">
			<header class="about-section__heading"><p aria-hidden="true">05</p><h2 id="service-title">Editorial &amp; Professional Service</h2></header>
			{professionalService.length ? <ul class="fact-list">{professionalService.map((item) => <li>{item.period && <time>{item.period}</time>}<div><h3>{item.title}</h3>{item.organization && <p>{item.organization}</p>}</div></li>)}</ul> : <p class="pending-note">Editorial and professional service details are pending verification.</p>}
		</section>
		<section class="about-section" aria-labelledby="talks-title">
			<header class="about-section__heading"><p aria-hidden="true">06</p><h2 id="talks-title">Invited, Keynote &amp; Plenary Talks</h2></header>
			{invitedTalks.length ? <ul class="fact-list">{invitedTalks.slice(0, 4).map((item) => <li>{item.period && <time>{item.period}</time>}<div><h3>{item.title}</h3>{item.organization && <p>{item.organization}</p>}</div></li>)}</ul> : <p class="pending-note">A concise selection of invited, keynote, and plenary talks is pending verification.</p>}
		</section>
		<section class="about-section cv-section" aria-labelledby="cv-title">
			<header class="about-section__heading"><p aria-hidden="true">07</p><h2 id="cv-title">Full CV</h2></header>
			{aboutProfile.cvPath ? <a class="cv-link" href={aboutProfile.cvPath}>Download curriculum vitae <span aria-hidden="true">↓</span></a> : <p class="pending-note">A CV download will be added when a verified PDF is available.</p>}
		</section>
	</div>
</BaseLayout>

<style>
	.about-intro { padding-bottom: clamp(3.5rem, 8vw, 6rem); }
	.about-intro h1 { max-width: 60rem; font-size: clamp(2.75rem, 9vw, 5.5rem); letter-spacing: -.035em; }
	.about-sections { border-top: 1px solid var(--color-rule); }
	.about-section { width: min(100%, var(--page-width)); margin-inline: auto; padding: clamp(3.5rem, 8vw, 6.5rem) var(--page-gutter); }
	.about-section + .about-section { border-top: 1px solid var(--color-rule); }
	.about-section__heading { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .75rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
	.about-section__heading > p { padding-top: .4rem; color: var(--color-accent); font-size: .7rem; font-weight: 600; letter-spacing: .08em; }
	.about-section h2 { font-size: clamp(2rem, 6vw, 3.5rem); letter-spacing: -.025em; overflow-wrap: anywhere; }
	.about-bio > p { max-width: 48rem; color: var(--color-muted); font-size: clamp(1rem, 2vw, 1.12rem); line-height: 1.75; }
	.profile-links, .item-links { display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; margin-top: 1.25rem; }
	.profile-links a, .cv-link { font-size: .8rem; font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
	address { display: grid; gap: .35rem; max-width: 38rem; font-style: normal; }
	.pending-note { padding-block: 1.25rem; border-block: 1px solid var(--color-rule); color: var(--color-muted); font-size: .88rem; font-style: italic; overflow-wrap: anywhere; }
	.subsection-pending { margin-top: 1rem; color: var(--color-muted); font-size: .8rem; font-style: italic; }
	.fact-list { border-bottom: 1px solid var(--color-rule); }
	.fact-list li { display: grid; grid-template-columns: minmax(0, 1fr); gap: .4rem 1rem; padding-block: 1.15rem; border-top: 1px solid var(--color-rule); }
	.fact-list time { color: var(--color-accent); font-size: .7rem; font-weight: 600; }
	.fact-list h3 { font-size: 1.15rem; overflow-wrap: anywhere; }
	.fact-list p { margin-top: .2rem; color: var(--color-muted); font-size: .82rem; overflow-wrap: anywhere; }
	@media (min-width: 45rem) {
		.about-section__heading { grid-template-columns: 3rem minmax(0, 1fr); }
		.fact-list li { grid-template-columns: 8rem minmax(0, 1fr); }
		.fact-list li > div:only-child { grid-column: 2; }
	}
</style>
