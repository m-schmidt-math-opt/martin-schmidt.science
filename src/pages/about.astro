---
import BaseLayout from '../layouts/BaseLayout.astro';
import TalkList from '../components/TalkList.astro';
import { aboutProfile, academicLeadership, academicPositions, affiliationsAndFellowships, awards, editorialService, education, reviewingActivity } from '../data/about';
import { introductoryCourseTalks, selectedPlenaryAndKeynoteTalks } from '../data/talks';
import { publicationsByKeys } from '../lib/publications';
import { externalLinkAttributes } from '../lib/links';

const factSections = [
	{ id: 'positions', title: 'Academic Positions', items: academicPositions },
	{ id: 'education', title: 'Education', items: education },
	{ id: 'leadership', title: 'Academic Leadership & Service', items: academicLeadership },
	{ id: 'affiliations', title: 'Affiliations & Fellowships', items: affiliationsAndFellowships },
];
const awardPublicationKeys = awards.flatMap((award) => award.relatedPublicationKey ? [award.relatedPublicationKey] : []);
const awardPublications = new Map(publicationsByKeys(awardPublicationKeys).map((publication) => [publication.id, publication]));
const publicationAnchor = (key: string) => `publication-${key.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
---

<BaseLayout title="About Martin Schmidt" description="Academic biography, contact information, positions, honors, and professional service of Martin Schmidt, Professor of Nonlinear Optimization at Trier University.">
	<header class="about-intro page-shell" aria-labelledby="page-title">
		<h1 id="page-title">About Martin Schmidt</h1>
		<p class="intro__lead">{aboutProfile.position} at {aboutProfile.institution}.</p>
	</header>
	<div class="about-sections">
		<section class="about-section about-bio" aria-label="Academic biography">
			<div class="about-bio__layout"><img src={aboutProfile.portrait.src} alt={aboutProfile.portrait.alt} width="960" height="640" loading="eager" /><p>{aboutProfile.biography}</p></div>
		</section>
		<section class="about-section" aria-labelledby="contact-title">
			<header class="about-section__heading"><h2 id="contact-title">Contact</h2></header>
			<div class="contact-grid">
				<address>{aboutProfile.contact.addressLines.map((line) => <span>{line}</span>)}</address>
				<div class="contact-column">
					<h3>Email</h3>
					<a href={`mailto:${aboutProfile.contact.email}`}>{aboutProfile.contact.email}</a>
				</div>
				<div class="contact-column">
					<h3>Profiles</h3>
					<ul class="profile-links" aria-label="Academic profiles and social media">
						<li><a href={aboutProfile.contact.institutionUrl} {...externalLinkAttributes(aboutProfile.contact.institutionUrl)}>University profile</a></li>
						{aboutProfile.profileLinks.map((link) => <li><a href={link.href} {...externalLinkAttributes(link.href)}>{link.label}</a></li>)}
					</ul>
				</div>
			</div>
		</section>
		{factSections.map((section) => <section class="about-section" aria-labelledby={`${section.id}-title`}><header class="about-section__heading"><h2 id={`${section.id}-title`}>{section.title}</h2></header><ul class="fact-list">{section.items.map((item) => <li>{item.period && <time>{item.period}</time>}<div><h3>{item.title}</h3>{item.organization && <p>{item.organization}</p>}{item.detail && <p>{item.detail}</p>}</div></li>)}</ul></section>)}
		<section class="about-section" aria-labelledby="awards-title">
			<header class="about-section__heading"><h2 id="awards-title">Awards &amp; Honors</h2></header>
			<ul class="fact-list">{awards.map((item) => { const publication = item.relatedPublicationKey ? awardPublications.get(item.relatedPublicationKey) : undefined; return <li>{item.period && <time>{item.period}</time>}<div><h3>{item.title}</h3>{item.organization && <p>{item.organization}</p>}{item.detail && <p>{item.detail}</p>}{publication && <p>For <a href={`/publications/#${publicationAnchor(publication.id)}`}><cite>{publication.title}</cite></a> · {publication.authors}</p>}</div></li>; })}</ul>
		</section>
		<section class="about-section" aria-labelledby="editorial-title">
			<header class="about-section__heading"><h2 id="editorial-title">Editorial Service</h2></header>
			<ul class="fact-list">{editorialService.map((item) => <li>{item.period && <time>{item.period}</time>}<div>{item.organization && <h3>{item.organization}</h3>}<p>{item.title}</p></div></li>)}</ul>
		</section>
		<section class="about-section" aria-labelledby="reviewing-title">
			<header class="about-section__heading"><h2 id="reviewing-title">Reviewing Activity</h2></header>
			<p class="reviewing-summary">{reviewingActivity.summary}</p><p class="reviewing-selection">Selected journals: {reviewingActivity.selectedJournals.join(' · ')}</p>
		</section>
		<section class="about-section" aria-labelledby="plenary-title">
			<header class="about-section__heading"><h2 id="plenary-title">Selected (Semi-)Plenary &amp; Keynote Talks</h2></header><TalkList talks={selectedPlenaryAndKeynoteTalks} /><a class="section-link" href="/talks/">View all talks <span aria-hidden="true">→</span></a>
		</section>
		<section class="about-section" aria-labelledby="courses-title">
			<header class="about-section__heading"><h2 id="courses-title">Introductory Courses &amp; Schools</h2></header><TalkList talks={introductoryCourseTalks} /><a class="section-link" href="/talks/">View all talks <span aria-hidden="true">→</span></a>
		</section>
	</div>
</BaseLayout>

<style>
	.about-intro { padding-bottom: var(--space-section-y); }
	.about-intro h1 { max-width: 60rem; font-size: var(--internal-h1-size); letter-spacing: -.035em; }
	.about-section { width: min(100%, var(--page-width)); margin-inline: auto; padding: var(--space-section-y) var(--page-gutter); }
	.about-section__heading { margin-bottom: var(--space-section-heading); }
	.about-section h2 { font-size: clamp(2rem, 6vw, 3.5rem); letter-spacing: -.025em; overflow-wrap: anywhere; }
	.about-bio__layout { display:grid;gap:1.5rem;align-items:start; }
	.about-bio__layout img { width:min(100%,22rem);height:auto; }
	.about-bio__layout p { max-width:48rem;color:var(--color-muted);font-size:clamp(1rem,2vw,1.12rem);line-height:1.75; }
	.contact-grid { display: grid; gap: 1.75rem; }
	.contact-column { min-width: 0; }
	.contact-column h3 { margin-bottom: .65rem; font-size: 1.05rem; }
	.contact-column > a { overflow-wrap: anywhere; }
	.profile-links, .item-links { display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; }
	.item-links { margin-top: 1.25rem; }
	.contact-grid .profile-links { display: grid; gap: .35rem; }
	.profile-links a, .section-link { font-size: .8rem; font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
	.section-link { display: inline-block; margin-top: 1.25rem; }
	address { display: grid; gap: .35rem; max-width: 38rem; font-style: normal; }
	.reviewing-summary { max-width:48rem;color:var(--color-muted);font-size:1rem;line-height:1.7; }
	.reviewing-selection { max-width:55rem;margin-top:1rem;color:var(--color-muted);font-size:.82rem;line-height:1.7; }
	.fact-list { border-bottom: 1px solid var(--color-rule); }
	.fact-list li { display: grid; grid-template-columns: minmax(0, 1fr); gap: .4rem 1rem; padding-block: 1.15rem; border-top: 1px solid var(--color-rule); }
	.fact-list time { color: var(--color-accent); font-size: .7rem; font-weight: 600; }
	.fact-list h3 { font-size: 1.15rem; overflow-wrap: anywhere; }
	.fact-list p { margin-top: .2rem; color: var(--color-muted); font-size: .82rem; overflow-wrap: anywhere; }
	@media (min-width: 45rem) {
		.about-bio__layout { grid-template-columns:minmax(15rem,22rem) minmax(0,1fr);gap:clamp(2rem,6vw,5rem); }
		.contact-grid { grid-template-columns: minmax(14rem, 1.2fr) minmax(14rem, 1fr) minmax(12rem, .8fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
		.fact-list li { grid-template-columns: 8rem minmax(0, 1fr); }
		.fact-list li > div:only-child { grid-column: 2; }
	}
</style>
